# Set the real public origin before enabling search indexing.
SITE_URL=http://localhost:3000
SITE_INDEXABLE=false

# Optional server-side inquiry delivery. Both values are required to enable sending.
# The endpoint receives JSON containing name, email, company, service and message.
CONTACT_WEBHOOK_URL=
CONTACT_WEBHOOK_TOKEN=

# Optional approved public contact address, displayed only when configured.
CONTACT_EMAIL=
